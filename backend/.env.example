# Copie para .env:  cp .env.example .env
DATABASE_URL="postgresql://finora:finora@localhost:5432/finora?schema=public"

# Gere um segredo forte:  openssl rand -hex 32
JWT_ACCESS_SECRET="troque-por-um-segredo-longo-e-aleatorio"

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

FRONTEND_URL="http://localhost:3000"
PORT=3001
APP_TIMEZONE="America/Manaus"

# Em produção com HTTPS, use true
COOKIE_SECURE=false

# Proxies na frente da API (para o rate limit enxergar o IP real).
# Local: 1. Produção com Vercel + Render: 2.
TRUST_PROXY_HOPS=1

# Neon (produção): use a conexão DIRETA (sem "-pooler" no host), por exemplo:
# DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
